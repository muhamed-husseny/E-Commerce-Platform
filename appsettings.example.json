{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER_HOST;Database=TalabatDb;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "IdentityConnection": "Server=YOUR_SQL_SERVER_HOST;Database=TalabatDbIdentity;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": "YOUR_REDIS_HOST:6379,password=YOUR_REDIS_PASSWORD"
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "https://localhost:7099",
  "JWT": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_MUST_BE_AT_LEAST_256_BITS",
    "Issuer": "TalabatIdentityApp",
    "Audience": "TalabatUsers",
    "DurationInDays": "30"
  },
  "EmailSettings": {
    "Host": "smtp.your-mail-provider.com",
    "Port": "587",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@yourdomain.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://yourfrontenddomain.com"
    ]
  },
  "SeedUser": {
    "DisplayName": "App Admin",
    "Email": "admin@yourdomain.com",
    "UserName": "admin",
    "PhoneNumber": "1234567890",
    "Password": "YOUR_STRONG_SEED_PASSWORD_HERE"
  }
}
