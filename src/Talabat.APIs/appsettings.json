{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TalabatDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "IdentityConnection": "Server=localhost;Database=TalabatDbIdentity;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true",
    "Redis": "localhost:6379"
  },
  "AllowedHosts": "*",
  "ApiBaseUrl": "https://localhost:7099",
  "JWT": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS_EXAMPLE_KEY_FOR_LOCAL_DEV",
    "Issuer": "TalabatIdentityApp",
    "Audience": "TalabatUsers",
    "DurationInDays": "30"
  },
  "EmailSettings": {
    "Host": "smtp.example.com",
    "Port": "587",
    "Username": "YOUR_SMTP_USERNAME",
    "Password": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@talabat.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "SeedUser": {
    "DisplayName": "App Admin",
    "Email": "admin@talabat.dev",
    "UserName": "admin",
    "PhoneNumber": "1234567890",
    "Password": "YOUR_ADMIN_SEED_PASSWORD_HERE"
  }
}